name: Run CreateUser APIs

on:
  workflow_dispatch:

jobs:

  postman:

    runs-on: self-hosted

    steps:

      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Newman
        run: npm install -g newman

      - name: Execute Collection
        run: |
          newman run postman/collections/CreateUser.postman_collection.json ^
          -e postman/collections/UAT.postman_environment.json
